SERVICE_NAME=accounting-consumer
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/accounting-queue
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=30
SQS_MAX_NUMBER_OF_MESSAGES=10
LEDGER_BACKEND=json-log
ACCOUNTING_ENTRIES_TABLE=finance-platform-accounting-entries
IDEMPOTENCY_BACKEND=memory
IDEMPOTENCY_TABLE=finance-platform-consumer-idempotency
